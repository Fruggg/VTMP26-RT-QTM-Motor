# ---------------- MOTOR CONTROL ----------------

def set_motor_positon(signal, sign, ID):

    index = ID - 1

    things = [3103, 949]

    signal = signal * sign

    if index == 0:
        goal_position = min(
            signal + 2048,
            things[index]
        )
    else:
        goal_position = max(
            signal + 2048,
            things[index]
        )

    goal_position = int(goal_position)

    goal_position = max(
        DXL_MINIMUM_POSITION_VALUE,
        min(goal_position, DXL_MAXIMUM_POSITION_VALUE)
    )

    dxl_comm_result, dxl_error = packetHandler.write4ByteTxRx(
        portHandler,
        ID,
        ADDR_GOAL_POSITION,
        goal_position
    )

    if dxl_comm_result != COMM_SUCCESS:
        print(
            f"Motor {ID} communication error: "
            f"{packetHandler.getTxRxResult(dxl_comm_result)}"
        )

    if dxl_error != 0:
        print(
            f"Motor {ID} error: "
            f"{packetHandler.getRxPacketError(dxl_error)}"
        )


def update_motors(signal):

    set_motor_positon(signal, 1, left_motor_id)
    set_motor_positon(signal, -1, right_motor_id)


# ---------------- QTM FUNCTIONS ----------------

def create_body_index(xml_string):

    xml = ET.fromstring(xml_string)

    body_to_index = {}

    for index, body in enumerate(xml.findall("*/Body/Name")):
        body_to_index[index] = body.text.strip()

    return body_to_index


def body_enabled_count(xml_string):

    xml = ET.fromstring(xml_string)

    return sum(
        enabled.text == "true"
        for enabled in xml.findall("*/Body/Enabled")
    )


# ---------------- MAIN ----------------

async def main():

    global clap_percent
    global packet_counter

    print("Set init position!")

    start_time = time.time()

    x = [0]
    y = [0]

    live_data = []
    live_time = []

    # QTM connection
    connection = await qtm_rt.connect(
        "141.213.186.223",
        version="1.24"
    )

    if connection is None:
        print("Failed to connect")
        return

    print("Connected to QTM")

    xml_string = await connection.get_parameters(
        parameters=["6d"]
    )

    index_to_body = create_body_index(xml_string)

    print(
        "{} of {} 6DoF bodies enabled".format(
            body_enabled_count(xml_string),
            len(index_to_body)
        )
    )

    # --------------------------------------------------------
    # VERIFY SELECTED BODIES
    # --------------------------------------------------------

    body_to_index = {
        name: index
        for index, name in index_to_body.items()
    }

    required_bodies = [
        LEFT_BODY_NAME,
        RIGHT_BODY_NAME
    ]

    missing_bodies = [
        name for name in required_bodies
        if name not in body_to_index
    ]

    if missing_bodies:
        print(
            f"ERROR: Missing QTM bodies: {missing_bodies}"
        )
        print(
            f"Available bodies: {list(body_to_index.keys())}"
        )
        return

    left_index = body_to_index[LEFT_BODY_NAME]
    right_index = body_to_index[RIGHT_BODY_NAME]

    print(f"Left body: {LEFT_BODY_NAME} (index {left_index})")
    print(f"Right body: {RIGHT_BODY_NAME} (index {right_index})")

    # ---------------- QTM PACKET CALLBACK ----------------

    def on_packet(packet):

        global packet_counter
        global clap_percent

        packet_counter = (
            packet_counter + 1
        ) % packet_modulo

        if packet_counter != 0:
            return

        info, bodies = packet.get_6d()

        if len(bodies) <= max(left_index, right_index):
            print("Selected QTM body indices are unavailable")
            return

        # ----------------------------------------------------
        # EXTRACT SELECTED BODY POSITIONS
        # ----------------------------------------------------

        positions = {}

        for body_index in [left_index, right_index]:

            body_name = index_to_body[body_index]

            position, rotation = bodies[body_index]

            positions[body_name] = [
                float(value)
                for value in position
            ]

        pos1 = positions[LEFT_BODY_NAME]
        pos2 = positions[RIGHT_BODY_NAME]

        # ---------------- DISTANCE ----------------

        distance_x = abs(pos1[0] - pos2[0])
        distance_y = abs(pos1[1] - pos2[1])
        distance_z = abs(pos1[2] - pos2[2])

        distance_norm = np.sqrt(
            distance_x ** 2 +
            distance_y ** 2 +
            distance_z ** 2
        )

        distance = float('{:.2f}'.format(distance_norm))

        # ---------------- CLAP PERCENT ----------------

        span_range = bigspan - smallspan

        if span_range == 0:
            print("ERROR: bigspan and smallspan are equal")
            return

        clap_percent = distance / span_range

        # ---------------- MOTOR CONTROL ----------------

        try:

            update_signal = int(
                clap_percent * 2048.0 / 2
            )

            update_motors(update_signal)

        except Exception as error:

            print(f"Motor update error: {error}")

        # ---------------- DEBUG ----------------

        if FLAG_print_everything_because_we_like_wasting_time:

            print(f"{LEFT_BODY_NAME}: {pos1}")
            print(f"{RIGHT_BODY_NAME}: {pos2}")

            print(
                f"Distance: {distance:.2f} "
                f"| Clap %: {clap_percent:.3f} "
                f"| Signal: {update_signal}"
            )

    # ---------------- START QTM STREAM ----------------

    while True:

        await connection.stream_frames(
            components=["6d"],
            on_packet=on_packet
        )


if __name__ == "__main__":
    asyncio.run(main())
